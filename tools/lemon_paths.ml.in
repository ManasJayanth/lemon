(* Generated by build.sh. *)
let absolute p =
  if Filename.is_relative p then Filename.concat (Sys.getcwd ()) p else p

let exe_dir () =
  Filename.dirname (absolute Sys.argv.(0))

let installed_root () =
  match (try Some (Sys.getenv "LEMON_LIB") with Not_found -> None) with
  | Some d -> absolute d
  | None -> Filename.concat (exe_dir ()) "../lib/lemon"

let pick baked rel =
  if Sys.file_exists baked then baked
  else Filename.concat (installed_root ()) rel

let plugin name =
  let beside = Filename.concat (exe_dir ()) name in
  if Sys.file_exists beside then beside
  else Filename.concat (installed_root ()) name

let melange_stdlib = pick "@BAKED_STDLIB@" "melange-stdlib"
let melange_assets = pick "@BAKED_ASSETS@" "melange-assets"
let react_lib = pick "@BAKED_REACT@" "react-lib"
let melange_js_lib = pick "@BAKED_JS@" "melange-js"
let react_npm = pick "@BAKED_NPM@" "react-npm"
